FROM ghcr.io/openai/tunnel-client:v0.0.18 AS tunnel
FROM oven/bun:1.4.4 AS bun
FROM tailscale/tailscale:v1.104.4 AS tailscale
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global pnpm@11.1.3
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
COPY --from=tunnel /usr/bin/tunnel-client /usr/local/bin/tunnel-client
COPY --from=tailscale /usr/local/bin/tailscale /usr/local/bin/tailscale
COPY --from=tailscale /usr/local/bin/tailscaled /usr/local/bin/tailscaled
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
ENV NODE_ENV=production AULA_MCP_HOST=127.0.0.1 AULA_MCP_PORT=7878 AULA_MCP_WRITE=0 AULA_MCP_RAW=0
CMD ["bash", "deploy/railway-start.sh"]
